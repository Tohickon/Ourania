<?xml version="1.0" encoding="utf-8"?>
<!--
  A secondary button: a lifted surface with a hairline edge, lavender text, and a ripple.

  The corner radius and the edge are what make a stock Android button stop looking stock.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/hairline" />
        </shape>
    </item>
</ripple>
